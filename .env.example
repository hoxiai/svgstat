
# Server
HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=30s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
# Set to true behind HTTPS in production
HTTP_COOKIE_SECURE=false
# Only these proxy IPs/CIDRs may supply X-Forwarded-* headers
HTTP_TRUSTED_PROXIES=127.0.0.1/32,::1/128
# Set to true if you explicitly want strict cross-origin CSRF checks enabled
CSRF_CHECK_ENABLED=false

# Comma-separated existing or future accounts allowed into /admin
ADMIN_EMAILS=admin@example.com

# PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_USER=svgstat
PG_PASSWORD=svgstat
PG_DATABASE=svgstat
PG_SSL_MODE=disable
PG_POOL_MAX=20
PG_POOL_MIN=5

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=20
REDIS_MIN_IDLE_CONNS=5

# Logging
LOG_LEVEL=info

# Cache
CACHE_TTL=5m

# Analytics
# Day-scoped Redis key TTL; must comfortably exceed WORKER_FLUSH_INTERVAL
ANALYTICS_KEY_TTL=72h
# Replace with a long random secret in every deployment
ANALYTICS_IP_SALT=change-me-in-production
# Per-project daily bounds for exact visitor sets and high-cardinality dimensions
ANALYTICS_MAX_DAILY_VISITORS=100000
ANALYTICS_MAX_DIMENSION_VALUES=1000

# Worker
# How often Redis analytics aggregates are persisted to PostgreSQL
WORKER_FLUSH_INTERVAL=15m
# Every API instance may enable the worker; a PostgreSQL advisory lock elects one leader
WORKER_ENABLED=true
WORKER_LOCK_ID=1937202501
